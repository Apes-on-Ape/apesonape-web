NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Magic Eden API (Bearer token) - for collection stats, holder count, floor price, etc.
# Get your key at https://docs.magiceden.io/reference/evm-api-keys
MAGIC_EDEN_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PINATA_JWT=
WEB3_STORAGE_TOKEN=
STUDIO_MAX_FILE_MB=20
NEXT_PUBLIC_STUDIO_MAX_FILE_MB=20
SOUNDCLOUD_USER_URL=https://soundcloud.com/apesonape
SOUNDCLOUD_CLIENT_ID=your_client_id_here
SOUNDCLOUD_CLIENT_SECRET=your_client_secret_here
SOUNDCLOUD_REDIRECT_URI=http://localhost:3000/api/auth/soundcloud/callback

# Google Drive (AOA album uploads) - OAuth to user's Drive
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorized redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/google/drive/callback
# 4. Enable Google Drive API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: upload albums into this folder (creates subfolders per album)
# Leave empty to create albums in user's Drive root
# Folder ID from URL: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_ALBUM_FOLDER_ID=

